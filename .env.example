# Browser URL for the local server-side OpenAI gateway.
VITE_AI_ENDPOINT=http://localhost:8787/api/planner
VITE_API_URL=http://localhost:8000

# Copy this file to .env.local. The gateway loads it automatically. Never commit a real key.
OPENAI_API_KEY=replace_with_a_new_rotated_key
OPENAI_MODEL=gpt-6-astra
PULSO_API_URL=http://localhost:8000
